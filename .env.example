# Password del panel de administración (/admin)
ADMIN_PASSWORD=cambia-este-password
# Secreto para firmar la cookie de sesión (cualquier cadena larga y aleatoria)
SESSION_SECRET=cambia-este-secreto

# Base de datos. En local se puede omitir: se usa el archivo local.db
# En Vercel los inyecta la integración de Turso:
# TURSO_DATABASE_URL=libsql://rotarios-xxxx.turso.io
# TURSO_AUTH_TOKEN=...
